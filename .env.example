# API Keys - Copy this file to .env and fill in your keys
# Register for free at the URLs below

# CORE API (https://core.ac.uk/services/api) - free 30-day trial
CORE_API_KEY=your_core_api_key_here

# Semantic Scholar API (https://www.semanticscholar.org/product/api) - free
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_key_here

# Email for polite API headers (OpenAlex, Crossref give better rates with email)
API_CONTACT_EMAIL=your.email@example.com
